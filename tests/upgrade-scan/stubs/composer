#!/usr/bin/env bash
echo "composer $*" >> "$STUB_LOG"
echo "composer no-dev=${COMPOSER_NO_DEV-unset}" >> "$STUB_LOG"
if [[ "$1" == config ]]; then echo vendor; exit 0; fi
if [[ "$1" == show ]]; then [[ -n "${STUB_LOCKED:-}" ]]; exit; fi
# A require changes both files; an install only writes a missing lock file.
if [[ "$1" == require ]]; then
  echo '{"changed": true}' > composer.json
  if [[ -n "${STUB_LOCK_AFTER:-}" ]]; then cp "$STUB_LOCK_AFTER" composer.lock; else echo '{"changed": true}' > composer.lock; fi
elif [[ "$1" == install && ! -f composer.lock ]]; then
  echo '{"changed": true}' > composer.lock
fi
if [[ "$1" == install && -n "${STUB_REINSTALL_FAIL:-}" && -f "$STUB_LOG.installed" ]]; then exit 1; fi
[[ "$1" == install ]] && touch "$STUB_LOG.installed"
if [[ -n "${STUB_COMPOSER_FAIL_ALL:-}" ]]; then exit 1; fi
if [[ -n "${STUB_COMPOSER_FAIL_FIRST:-}" && "$1" == require && "$*" != *core-dev* ]]; then exit 1; fi
exit 0
